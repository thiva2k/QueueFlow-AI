# Production API base, baked into the build by Vite (`vite build`).
# Committed so the deployed site has a working backend even if the Vercel
# dashboard env var is unset. NOTE: a value set in the Vercel dashboard (even an
# empty one) OVERRIDES this file — keep the dashboard var unset or matching.
VITE_API_BASE_URL=https://queueflow-ai-backend.onrender.com
