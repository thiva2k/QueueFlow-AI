# Base URL for the QueueFlow backend API.
# Dev-only: point at your locally running backend.
VITE_API_BASE_URL=http://127.0.0.1:8000
# In production this is set to the deployed backend instead, e.g.:
# VITE_API_BASE_URL=https://queueflow-ai-backend.onrender.com

# Optional staff API key. When set, it is sent as the `X-API-Key` header on
# every request. Harmless on public GETs; required for admin/counter/service
# mutations now that the backend enforces staff auth. Leave unset for citizen
# (read/booking) deployments.
# VITE_STAFF_API_KEY=your-staff-api-key
