# Comma-separated list of allowed browser origins (no trailing slash).
# In production this MUST include the deployed frontend origin, e.g.:
#   CORS_ORIGINS=https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database. Defaults to local SQLite. For production use a managed Postgres,
# e.g. QUEUEFLOW_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/db
QUEUEFLOW_DATABASE_URL=sqlite:///./queueflow.db

# Staff authentication. Admin/counter/service-mutation routes require an
# "X-API-Key: <this value>" header and reject every request when this is unset.
# Staff type the same value into the dashboard. Do not put it in a VITE_ variable.
# STAFF_API_KEY=change-me-to-a-long-random-string

# Seed demo data on startup when the database is empty (default true). Set to
# false for a real deployment so production data is never auto-overwritten.
# SEED_ON_START=true
